# ============================================================
# Samacheer PDF Server - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ============================================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# File Management
TEMP_FILE_RETENTION_HOURS=24

# ============================================================
# Anthropic Claude API (replaces Kimi)
# ============================================================
ANTHROPIC_API_KEY=sk-ant-your-actual-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================================
# Bridge - Absolute path to Node.js Content Server root
# ============================================================
CONTENT_SERVER_PATH=/home/dravidkumar/test_m1_and_m2/content-qa-lp/samacheer-kalvi

# ============================================================
# DEPRECATED - Remove once all catalogs are local JSON files
# ============================================================
