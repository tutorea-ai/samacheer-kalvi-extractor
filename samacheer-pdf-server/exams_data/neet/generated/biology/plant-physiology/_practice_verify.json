      ],
      "blind_answer": 4,
      "confidence": "high",
      "blind_working": "Calvin's 14C tracing showed the first stable product is the 3-carbon compound 3-phosphoglyceric acid (3-PGA)."
    },
    {
      "q_id": "neet_bio_u04_t02_2",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        1
      ],
      "blind_answer": 1,
      "confidence": "high",
      "blind_working": "One glucose needs 6 turns, using 18 ATP and 12 NADPH. Two glucose therefore need 36 ATP and 24 NADPH."
    },
    {
      "q_id": "neet_bio_u04_t02_3",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        3
      ],
      "blind_answer": 3,
      "confidence": "high",
      "blind_working": "The water-splitting complex is associated with PS II on the lumen side of the thylakoid. It requires Mn2+ and Cl-."
    },
    {
      "q_id": "neet_bio_u04_t02_4",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        2
      ],
      "blind_answer": 2,
      "confidence": "high",
      "blind_working": "The Calvin cycle runs in the bundle sheath cells of C4 plants and in C3 plants, so A is true. RuBisCO is the most abundant enzyme, so R is true. R does not explain A."
    },
    {
      "q_id": "neet_bio_u04_t02_5",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        3
      ],
      "blind_answer": 3,
      "confidence": "high",
      "blind_working": "Each CO2 fixed needs 3 ATP and 2 NADPH, so 5 CO2 need 15 ATP and 10 NADPH; I is correct. Four glucose need 24 turns, not 4; II is incorrect."
    },
