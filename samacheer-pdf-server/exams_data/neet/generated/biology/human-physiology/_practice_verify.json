    {
      "q_id": "neet_bio_u05_t02_1",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        4
      ],
      "blind_answer": 4,
      "confidence": "high",
      "blind_working": "About 97% of O2 is carried by RBCs as oxyhaemoglobin. The remaining ~3% travels dissolved in plasma."
    },
    {
      "q_id": "neet_bio_u05_t02_2",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        1
      ],
      "blind_answer": 1,
      "confidence": "high",
      "blind_working": "Vital capacity = TV + IRV + ERV = 500 + 2500 + 1000 = 4000 mL. RV is not included in vital capacity."
    },
    {
      "q_id": "neet_bio_u05_t02_3",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        1
      ],
      "blind_answer": 1,
      "confidence": "high",
      "blind_working": "Oxyhaemoglobin formation is favoured by high pO2, low pCO2, low H+ and lower temperature, as in the alveoli."
    },
    {
      "q_id": "neet_bio_u05_t02_4",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        1
      ],
      "blind_answer": 1,
      "confidence": "high",
      "blind_working": "CO2 is 20-25 times more soluble than O2. That higher solubility is why CO2 diffuses much faster for the same partial pressure difference, so R explains A."
    },
    {
      "q_id": "neet_bio_u05_t02_5",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        1
      ],
      "blind_answer": 1,
      "confidence": "high",
      "blind_working": "I: alveolar pO2 of 104 mm Hg exceeds 40 mm Hg in deoxygenated blood, so O2 diffuses into the blood (correct). II: about 70% of CO2 is carried as bicarbonate, formed with the help of carbonic anhydrase (correct)."
    },
