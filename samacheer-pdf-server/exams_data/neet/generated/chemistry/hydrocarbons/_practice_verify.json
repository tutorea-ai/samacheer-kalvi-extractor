      "q_id": "neet_che_u15_t02_1",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        1
      ],
      "blind_answer": 1,
      "confidence": "high",
      "blind_working": "In staggered ethane, each C-H on the front carbon lies midway between two rear C-H bonds, so the nearest dihedral angle is 60°."
    },
    {
      "q_id": "neet_che_u15_t02_2",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        1
      ],
      "blind_answer": 1,
      "confidence": "high",
      "blind_working": "In a Newman projection the front carbon is a point. The rear carbon is a circle, with its bonds drawn from the circle's edge."
    },
    {
      "q_id": "neet_che_u15_t02_3",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        1
      ],
      "blind_answer": 1,
      "confidence": "high",
      "blind_working": "Staggered and eclipsed forms alternate every 60° of rotation, so the minimum rotation is 60°."
    },
    {
      "q_id": "neet_che_u15_t02_4",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        4
      ],
      "blind_answer": 4,
      "confidence": "high",
      "blind_working": "The rotational barrier is only about 12.5 kJ/mol, so the conformers interconvert rapidly at room temperature and cannot be separated; A is false. Staggered ethane does have less torsional strain than eclipsed; R is true."
    },
    {
      "q_id": "neet_che_u15_t02_5",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        2
      ],
      "blind_answer": 2,
      "confidence": "high",
      "blind_working": "Per NCERT, bond lengths and bond angles are the same in both conformations, so I is incorrect. In a Sawhorse projection the front carbon is at the lower-left end and the rear carbon at the upper-right, so II is incorrect."
    },
