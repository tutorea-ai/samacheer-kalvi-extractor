    {
      "q_id": "neet_che_u20_t07_1",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        1
      ],
      "blind_answer": 1,
      "confidence": "high",
      "blind_working": "Brisk effervescence with dilute acid means a carbonate. The CO2 released turns lime water milky because CaCO3 forms."
    },
    {
      "q_id": "neet_che_u20_t07_2",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        2
      ],
      "blind_answer": 2,
      "confidence": "high",
      "blind_working": "In [Fe(H2O)5NO]2+ the NO is bound as NO+, so x + 1 = +2 and x = +1. This is the textbook assignment; the true electronic structure is debated."
    },
    {
      "q_id": "neet_che_u20_t07_3",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        4
      ],
      "blind_answer": 4,
      "confidence": "high",
      "blind_working": "This is the chromyl chloride test. Orange-red CrO2Cl2 vapours give yellow Na2CrO4 in NaOH, which precipitates yellow PbCrO4 with lead acetate. The anion is Cl-."
    },
    {
      "q_id": "neet_che_u20_t07_4",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        4
      ],
      "blind_answer": 4,
      "confidence": "high",
      "blind_working": "S2- gives violet with nitroprusside (I). NO2- liberates I2 so KI-starch turns blue (II). SO4 2- gives BaSO4, insoluble in conc. HCl (III). I- gives a violet CCl4 layer with Cl2 water (IV)."
    },
    {
      "q_id": "neet_che_u20_t07_5",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        3
      ],
      "blind_answer": 3,
      "confidence": "high",
      "blind_working": "A is true: AgCl is white and dissolves in NH4OH. B is false: AgI is practically insoluble in NH4OH. C is true: nitrite interferes and is destroyed by sulphamic acid. D is true: Br2 vapours are reddish-brown. E is false: BaSO4 is insoluble in conc. HCl. So A, C and D are correct."
    },
    {
      "q_id": "neet_che_u20_t08_1",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        3
      ],
      "blind_answer": 3,
      "confidence": "high",
      "blind_working": "Dissolving anhydrous CuSO4 is exothermic because the hydration energy is large. So the temperature rises and ΔsolH is negative."
    },
    {
      "q_id": "neet_che_u20_t08_2",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        4
      ],
      "blind_answer": 4,
      "confidence": "high",
      "blind_working": "q = 200 g × 4.18 J/g·K × 8.0 K = 6688 J. Moles = 15.95/159.5 = 0.1 mol. ΔH = −6.688 kJ / 0.1 mol ≈ −66.9 kJ/mol (negative because temperature rose)."
    },
    {
      "q_id": "neet_che_u20_t08_3",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        1
      ],
      "blind_answer": 1,
      "confidence": "high",
      "blind_working": "By Hess's law, ΔH = ΔsolH(anhydrous) − ΔsolH(pentahydrate) = −66.5 − 11.7 = −78.2 kJ/mol."
    },
    {
      "q_id": "neet_che_u20_t08_4",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        3
      ],
      "blind_answer": 3,
      "confidence": "high",
      "blind_working": "Pentahydrate dissolution is endothermic (+11.7 kJ/mol), so the temperature falls and A is true. Its ions are already partly hydrated, so the further hydration energy does not exceed the lattice energy. R is therefore false."
    },
    {
      "q_id": "neet_che_u20_t08_5",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        4
      ],
      "blind_answer": 4,
      "confidence": "high",
      "blind_working": "Statement I is incorrect: dissolution is exothermic because hydration energy exceeds lattice energy, not the reverse. Statement II is correct: ΔhydH = ΔsolH(anhydrous) − ΔsolH(pentahydrate)."
    },
