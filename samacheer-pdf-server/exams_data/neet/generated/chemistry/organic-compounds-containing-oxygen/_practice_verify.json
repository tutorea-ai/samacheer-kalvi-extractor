      "blind_working": "In (CH3)3CCHO the alpha carbon is quaternary, bearing three CH3 groups and the CHO, so it has no alpha-H. Options 2, 3 and 4 all have alpha-H."
    },
    {
      "q_id": "neet_che_u17_t10_2",
      "published": true,
      "reason": null,
      "manual_approved": false,
      "our_answer": [
        2
      ],
      "blind_answer": 2,
      "confidence": "high",
      "blind_working": "The CH2 hydrogens between the two C=O groups of acetylacetone are the most acidic (pKa about 9). The conjugate base is stabilised by resonance onto both oxygens."
    },
